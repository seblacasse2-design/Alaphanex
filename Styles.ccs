/* =====================================================================
   BOISCLAIR SERVICES — Feuille de style principale
   Débroussaillage forestier & déboisement — Québec
   ===================================================================== */

/* ---------- Fonts ---------- */
@import url('https://fonts.googleapis.com/css2?family=Zilla+Slab:wght@400;500;600;700&family=Public+Sans:wght@400;500;600;700;800&display=swap');

/* ---------- Design tokens ---------- */
:root{
  --bg:        #F5F3EC;
  --bg-alt:    #ECE7D8;
  --panel:     #FFFFFF;
  --ink:       #1C2620;
  --ink-soft:  #3B4A3D;
  --moss:      #4F6B52;
  --moss-dark: #2E3F31;
  --amber:     #E09A2E;
  --amber-dark:#B87B1B;
  --stone:     #CFC9B6;
  --stone-dark:#A9A288;
  --white:     #FFFFFF;
  --danger:    #A5402B;

  --font-head: 'Zilla Slab', Georgia, serif;
  --font-body: 'Public Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;

  --maxw: 1180px;
  --radius: 2px;
  --shadow-1: 0 1px 0 rgba(28,38,32,.06);
  --shadow-2: 0 14px 34px -18px rgba(28,38,32,.35);
}

/* ---------- Reset ---------- */
*, *::before, *::after{ box-sizing: border-box; }
html{ scroll-behavior: smooth; }
@media (prefers-reduced-motion: reduce){
  html{ scroll-behavior: auto; }
  *, *::before, *::after{ animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important; scroll-behavior: auto !important; }
}
body{
  margin:0;
  background: var(--bg);
  color: var(--ink);
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}
img{ max-width:100%; display:block; }
a{ color: inherit; text-decoration: none; }
ul{ margin:0; padding:0; list-style:none; }
h1,h2,h3,h4{ font-family: var(--font-head); font-weight:600; line-height:1.12; margin:0; color: var(--ink); }
p{ margin:0; }
button{ font-family: inherit; cursor:pointer; }
input, textarea, select{ font-family: inherit; font-size: 1rem; }

:focus-visible{
  outline: 3px solid var(--amber);
  outline-offset: 2px;
}

.container{
  width:100%;
  max-width: var(--maxw);
  margin: 0 auto;
  padding: 0 24px;
}

.visually-hidden{
  position:absolute !important;
  width:1px; height:1px;
  padding:0; margin:-1px;
  overflow:hidden;
  clip:rect(0,0,0,0);
  white-space:nowrap;
  border:0;
}

.skip-link{
  position:absolute;
  left: 12px;
  top: -60px;
  background: var(--ink);
  color: var(--white);
  padding: 10px 16px;
  z-index: 200;
  transition: top .15s ease;
  border-radius: var(--radius);
}
.skip-link:focus{ top: 12px; }

/* ---------- Eyebrow / labels ---------- */
.eyebrow{
  display:inline-flex;
  align-items:center;
  gap:8px;
  font-size: .8125rem;
  font-weight:600;
  color: var(--moss-dark);
  letter-spacing:.01em;
}
.eyebrow::before{
  content:"";
  width:22px; height:2px;
  background: var(--amber);
  display:inline-block;
}

/* ---------- Buttons ---------- */
.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:10px;
  padding: 14px 26px;
  font-weight:700;
  font-size: .98rem;
  border: 2px solid transparent;
  border-radius: var(--radius);
  transition: transform .12s ease, background-color .15s ease, border-color .15s ease, color .15s ease;
  white-space: nowrap;
}
.btn-primary{
  background: var(--amber);
  color: var(--ink);
  border-color: var(--amber);
}
.btn-primary:hover{ background: var(--amber-dark); border-color: var(--amber-dark); transform: translateY(-1px); }
.btn-outline{
  background: transparent;
  color: var(--ink);
  border-color: var(--ink);
}
.btn-outline:hover{ background: var(--ink); color: var(--white); transform: translateY(-1px); }
.btn-outline-light{
  background: transparent;
  color: var(--white);
  border-color: rgba(255,255,255,.55);
}
.btn-outline-light:hover{ background: rgba(255,255,255,.12); border-color: var(--white); }
.btn-block{ width:100%; }
.btn svg{ width:18px; height:18px; flex-shrink:0; }

/* =====================================================================
   HEADER
   ===================================================================== */
.site-header{
  position: sticky;
  top:0;
  z-index: 100;
  background: rgba(245,243,236,.92);
  backdrop-filter: saturate(140%) blur(8px);
  border-bottom: 1px solid var(--stone);
}
.header-inner{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap: 20px;
  padding: 14px 0;
}
.brand{
  display:flex;
  align-items:center;
  gap:10px;
  flex-shrink:0;
}
.brand-mark{ width:38px; height:38px; }
.brand-text{
  font-family: var(--font-head);
  font-weight:700;
  font-size: 1.28rem;
  letter-spacing: .01em;
  line-height:1;
}
.brand-text span{ display:block; font-family: var(--font-body); font-weight:600; font-size:.62rem; letter-spacing:.11em; color: var(--moss-dark); margin-top:3px; }

.main-nav{ display:flex; align-items:center; gap: 28px; }
.main-nav a{
  font-weight:600;
  font-size: .93rem;
  color: var(--ink-soft);
  position:relative;
  padding: 6px 2px;
}
.main-nav a:hover{ color: var(--ink); }
.main-nav a::after{
  content:"";
  position:absolute;
  left:0; right:100%;
  bottom:0;
  height:2px;
  background: var(--amber);
  transition: right .18s ease;
}
.main-nav a:hover::after{ right:0; }

.header-actions{ display:flex; align-items:center; gap:14px; }
.lang-switch{
  display:flex;
  border: 1px solid var(--stone-dark);
  border-radius: var(--radius);
  overflow:hidden;
  font-size:.78rem;
  font-weight:700;
}
.lang-switch a{
  padding: 6px 10px;
  color: var(--ink-soft);
}
.lang-switch a.active{ background: var(--ink); color: var(--white); }
.header-phone{
  display:flex;
  align-items:center;
  gap:8px;
  font-weight:700;
  font-size: .95rem;
  white-space: nowrap;
}
.header-phone svg{ width:18px; height:18px; color: var(--amber-dark); }

.nav-toggle{
  display:none;
  width:42px; height:42px;
  align-items:center; justify-content:center;
  background:transparent;
  border: 1px solid var(--stone-dark);
  border-radius: var(--radius);
}
.nav-toggle svg{ width:22px; height:22px; }

@media (max-width: 980px){
  .main-nav{
    position: fixed;
    inset: 68px 0 0 0;
    background: var(--bg);
    flex-direction: column;
    align-items: flex-start;
    padding: 24px;
    gap: 4px;
    overflow-y:auto;
    transform: translateX(100%);
    transition: transform .22s ease;
  }
  .main-nav.open{ transform: translateX(0); }
  .main-nav a{ width:100%; padding: 14px 4px; border-bottom:1px solid var(--stone); font-size:1.05rem; }
  .header-phone span{ display:none; }
  .nav-toggle{ display:flex; }
}

/* =====================================================================
   HERO
   ===================================================================== */
.hero{
  position:relative;
  overflow:hidden;
  background: var(--ink);
  color: var(--white);
}
.hero-contours{
  position:absolute;
  inset:0;
  width:100%; height:100%;
  opacity:.16;
}
.hero-inner{
  position:relative;
  padding: 88px 0 76px;
  display:grid;
  grid-template-columns: minmax(0,1.15fr) minmax(0,.85fr);
  gap: 48px;
  align-items:end;
}
.hero-eyebrow{
  display:inline-flex; align-items:center; gap:8px;
  font-size:.8125rem; font-weight:700; letter-spacing:.01em;
  color: var(--amber);
  margin-bottom: 18px;
}
.hero-eyebrow::before{ content:""; width:22px; height:2px; background: var(--amber); }
.hero h1{
  color: var(--white);
  font-size: clamp(2.3rem, 4.4vw, 3.55rem);
  max-width: 15ch;
}
.hero h1 em{ font-style:normal; color: var(--amber); }
.hero-sub{
  margin-top: 22px;
  font-size: 1.13rem;
  color: rgba(255,255,255,.82);
  max-width: 56ch;
  line-height:1.65;
}
.hero-cta{ display:flex; flex-wrap:wrap; gap:14px; margin-top: 32px; }

.hero-stats{
  display:grid;
  grid-template-columns: repeat(3,1fr);
  border-top: 1px solid rgba(255,255,255,.18);
  margin-top: 56px;
  padding-top: 26px;
}
.hero-stats .stat + .stat{ border-left: 1px solid rgba(255,255,255,.18); padding-left: 22px; }
.stat b{ display:block; font-family: var(--font-head); font-size: 2.1rem; color: var(--white); font-weight:700; }
.stat span{ font-size: .82rem; color: rgba(255,255,255,.68); }

.hero-panel{
  background: rgba(255,255,255,.06);
  border: 1px solid rgba(255,255,255,.18);
  padding: 26px;
  align-self:end;
}
.hero-panel .stars{ color: var(--amber); font-size:1.1rem; letter-spacing:2px; }
.hero-panel p{ margin-top:12px; color: rgba(255,255,255,.85); line-height:1.6; font-size:.98rem; }
.hero-panel .who{ margin-top:14px; font-weight:700; font-size:.9rem; color: var(--white); }

@media (max-width: 900px){
  .hero-inner{ grid-template-columns: 1fr; }
  .hero-stats{ grid-template-columns: 1fr 1fr; row-gap:20px; }
  .hero-stats .stat:nth-child(3){ border-left:none; padding-left:0; grid-column: 1 / -1; border-top:1px solid rgba(255,255,255,.18); padding-top:20px;}
}

/* =====================================================================
   TRUST BAR
   ===================================================================== */
.trust-bar{
  background: var(--bg-alt);
  border-bottom: 1px solid var(--stone);
  padding: 16px 0;
}
.trust-inner{
  display:flex; flex-wrap:wrap; gap: 14px 36px;
  align-items:center; justify-content:center;
  font-size:.85rem; font-weight:600; color: var(--ink-soft);
  text-align:center;
}
.trust-inner .item{ display:flex; align-items:center; gap:8px; }
.trust-inner svg{ width:18px; height:18px; color: var(--moss); flex-shrink:0; }

/* =====================================================================
   SECTION SHELL
   ===================================================================== */
.section{ padding: 92px 0; }
.section-alt{ background: var(--bg-alt); }
.section-dark{ background: var(--ink); color: var(--white); }
.section-dark h2, .section-dark h3{ color: var(--white); }
.section-head{ max-width: 640px; margin-bottom: 48px; }
.section-head h2{ font-size: clamp(1.8rem, 3vw, 2.5rem); margin-top: 14px; }
.section-head p{ margin-top: 16px; font-size: 1.05rem; color: var(--ink-soft); line-height:1.65; }
.section-dark .section-head p{ color: rgba(255,255,255,.75); }

.divider-contour{ display:block; width:100%; height:34px; color: var(--stone-dark); opacity:.7; }

/* =====================================================================
   PROBLEM / SOLUTION
   ===================================================================== */
.split-grid{
  display:grid;
  grid-template-columns: 1fr 1fr;
  gap: 28px;
}
.split-card{
  padding: 34px 30px;
  border: 1px solid var(--stone);
  background: var(--panel);
}
.split-card.solution{
  background: var(--moss-dark);
  border-color: var(--moss-dark);
  color: var(--white);
}
.split-card h3{ font-size:1.35rem; }
.split-card.solution h3{ color: var(--white); }
.split-list{ margin-top: 20px; display:flex; flex-direction:column; gap: 14px; }
.split-list li{ display:flex; gap: 12px; align-items:flex-start; line-height:1.55; }
.split-list svg{ width:20px; height:20px; flex-shrink:0; margin-top:2px; }
.split-card:not(.solution) svg{ color: var(--danger); }
.split-card.solution svg{ color: var(--amber); }
@media (max-width: 800px){ .split-grid{ grid-template-columns:1fr; } }

/* =====================================================================
   SERVICES GRID
   ===================================================================== */
.services-grid{
  display:grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: var(--stone);
  border: 1px solid var(--stone);
}
.service-card{
  background: var(--panel);
  padding: 32px 28px;
  display:flex;
  flex-direction:column;
  gap:14px;
  transition: background-color .15s ease;
}
.service-card:hover{ background: var(--bg-alt); }
.service-icon{ width:40px; height:40px; color: var(--amber-dark); }
.service-card h3{ font-size: 1.12rem; }
.service-card p{ color: var(--ink-soft); font-size: .94rem; line-height:1.6; }
.service-card .service-link{ margin-top:auto; font-weight:700; font-size:.85rem; color: var(--moss-dark); display:inline-flex; align-items:center; gap:6px; }
.service-card .service-link svg{ width:15px; height:15px; transition: transform .15s ease; }
.service-card:hover .service-link svg{ transform: translateX(3px); }

@media (max-width: 900px){ .services-grid{ grid-template-columns: repeat(2,1fr); } }
@media (max-width: 620px){ .services-grid{ grid-template-columns: 1fr; } }

/* =====================================================================
   PROCESS
   ===================================================================== */
.process-grid{
  display:grid;
  grid-template-columns: repeat(3,1fr);
  gap: 40px;
  position:relative;
}
.process-step{ position:relative; padding-left: 0; }
.process-num{
  font-family: var(--font-head);
  font-size: 3.1rem;
  font-weight:700;
  color: transparent;
  -webkit-text-stroke: 1.5px var(--amber-dark);
  line-height:1;
  margin-bottom: 14px;
  display:block;
}
.process-step h3{ font-size:1.2rem; margin-bottom:10px; }
.process-step p{ color: var(--ink-soft); line-height:1.6; }
@media (max-width: 800px){ .process-grid{ grid-template-columns:1fr; gap:32px; } }

/* =====================================================================
   BEFORE / AFTER STRIP
   ===================================================================== */
.ba-grid{
  display:grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 4px;
}
.ba-item{
  position:relative;
  aspect-ratio: 4/3;
  background: var(--moss-dark);
  overflow:hidden;
}
.ba-item svg{ width:100%; height:100%; }
.ba-label{
  position:absolute; left:14px; bottom:14px;
  background: rgba(28,38,32,.82);
  color: var(--white);
  font-size:.78rem; font-weight:700;
  padding: 6px 12px;
  letter-spacing:.03em;
}
@media (max-width: 760px){ .ba-grid{ grid-template-columns:1fr; } }

/* =====================================================================
   WHY US
   ===================================================================== */
.why-grid{
  display:grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
}
.why-card{ padding-top: 4px; }
.why-card .num{ font-family: var(--font-head); font-size:.85rem; font-weight:700; color: var(--amber); letter-spacing:.06em; }
.why-card h3{ margin-top: 10px; font-size: 1.22rem; color: var(--white); }
.why-card p{ margin-top: 10px; color: rgba(255,255,255,.72); line-height:1.65; }
@media (max-width: 800px){ .why-grid{ grid-template-columns:1fr; } }

/* =====================================================================
   SERVICE AREA
   ===================================================================== */
.area-wrap{
  display:grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items:center;
}
.area-list{ display:grid; grid-template-columns: 1fr 1fr; gap: 10px 24px; margin-top: 24px;}
.area-list li{ display:flex; align-items:center; gap:10px; font-weight:600; font-size:.95rem; padding: 8px 0; border-bottom:1px solid var(--stone); }
.area-list svg{ width:16px; height:16px; color: var(--moss); flex-shrink:0; }
.area-map{ border: 1px solid var(--stone); background: var(--bg-alt); padding: 20px; }
@media (max-width: 860px){ .area-wrap{ grid-template-columns:1fr; } }

/* =====================================================================
   TESTIMONIALS
   ===================================================================== */
.testi-grid{
  display:grid;
  grid-template-columns: repeat(3,1fr);
  gap: 24px;
}
.testi-card{
  background: var(--panel);
  border: 1px solid var(--stone);
  padding: 28px;
  display:flex;
  flex-direction:column;
  gap: 16px;
}
.testi-card .stars{ color: var(--amber-dark); letter-spacing:2px; }
.testi-card p{ font-size: 1rem; line-height:1.65; color: var(--ink-soft); flex-grow:1; }
.testi-name{ font-weight:700; font-size: .92rem; padding-top:10px; border-top: 1px solid var(--stone); }
.testi-name span{ display:block; font-weight:500; color: var(--ink-soft); font-size:.82rem; margin-top:2px; }
@media (max-width: 900px){ .testi-grid{ grid-template-columns:1fr; } }

/* =====================================================================
   FAQ (accordion)
   ===================================================================== */
.faq-list{ max-width: 820px; }
.faq-item{ border-bottom: 1px solid var(--stone); }
.faq-q{
  width:100%;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap: 20px;
  padding: 22px 4px;
  background:none;
  border:none;
  text-align:left;
  font-family: var(--font-head);
  font-size: 1.08rem;
  font-weight:600;
  color: var(--ink);
}
.faq-q svg{ width:20px; height:20px; flex-shrink:0; color: var(--amber-dark); transition: transform .2s ease; }
.faq-item[open] .faq-q svg{ transform: rotate(45deg); }
.faq-a{ padding: 0 4px 24px; color: var(--ink-soft); line-height:1.7; max-width: 68ch; }
.faq-item summary{ list-style:none; }
.faq-item summary::-webkit-details-marker{ display:none; }

/* =====================================================================
   CONTACT
   ===================================================================== */
.contact-wrap{
  display:grid;
  grid-template-columns: 1fr 1fr;
  gap: 50px;
}
.contact-info-card{
  background: var(--ink);
  color: var(--white);
  padding: 38px 32px;
}
.contact-info-card h3{ color: var(--white); font-size:1.3rem; }
.contact-info-card p{ margin-top:12px; color: rgba(255,255,255,.75); line-height:1.6; }
.contact-line{ display:flex; gap:14px; align-items:flex-start; margin-top: 22px; }
.contact-line svg{ width:20px; height:20px; color: var(--amber); flex-shrink:0; margin-top:2px; }
.contact-line a, .contact-line span{ font-weight:600; }
.social-row{ display:flex; gap:12px; margin-top: 30px; }
.social-row a{
  width:38px; height:38px;
  border:1px solid rgba(255,255,255,.3);
  display:flex; align-items:center; justify-content:center;
}
.social-row svg{ width:17px; height:17px; }
.social-row a:hover{ background: rgba(255,255,255,.12); }

.form-card{ background: var(--panel); border: 1px solid var(--stone); padding: 36px 32px; }
.form-row{ display:grid; grid-template-columns: 1fr 1fr; gap: 18px; }
.field{ margin-bottom: 18px; }
.field label{ display:block; font-weight:700; font-size:.85rem; margin-bottom:7px; }
.field input, .field select, .field textarea{
  width:100%;
  padding: 12px 14px;
  border: 1px solid var(--stone-dark);
  background: var(--white);
  border-radius: var(--radius);
}
.field textarea{ resize: vertical; min-height: 120px; }
.field small{ display:block; margin-top:6px; color: var(--ink-soft); font-size:.8rem; }
.form-note{ font-size:.82rem; color: var(--ink-soft); margin-top:14px; }
.form-success{
  display:none;
  padding: 16px 18px;
  background: #E7EFE4;
  border: 1px solid var(--moss);
  color: var(--moss-dark);
  font-weight:600;
  margin-bottom: 18px;
}
.form-success.show{ display:block; }

@media (max-width: 860px){
  .contact-wrap{ grid-template-columns:1fr; }
  .form-row{ grid-template-columns:1fr; }
}

/* =====================================================================
   NEWSLETTER / FINAL CTA
   ===================================================================== */
.final-cta{
  background: linear-gradient(135deg, var(--moss-dark), var(--ink));
  color: var(--white);
  text-align:center;
  padding: 96px 0;
}
.final-cta .eyebrow{ color: var(--amber); justify-content:center; }
.final-cta .eyebrow::before{ display:none; }
.final-cta h2{ color: var(--white); font-size: clamp(1.9rem, 3.6vw, 2.9rem); max-width: 22ch; margin: 16px auto 0; }
.final-cta p{ max-width: 56ch; margin: 18px auto 0; color: rgba(255,255,255,.78); font-size:1.05rem; }
.final-cta .hero-cta{ justify-content:center; margin-top:32px; }

/* =====================================================================
   FOOTER
   ===================================================================== */
.site-footer{ background: var(--ink); color: rgba(255,255,255,.72); padding: 70px 0 28px; }
.footer-grid{
  display:grid;
  grid-template-columns: 1.4fr 1fr 1fr 1fr;
  gap: 40px;
  padding-bottom: 48px;
  border-bottom: 1px solid rgba(255,255,255,.14);
}
.footer-brand .brand-text{ color: var(--white); }
.footer-brand .brand-text span{ color: rgba(255,255,255,.55); }
.footer-grid p{ margin-top: 16px; line-height:1.65; font-size:.92rem; max-width: 32ch; }
.footer-col h4{ color: var(--white); font-family: var(--font-body); font-size:.82rem; font-weight:700; letter-spacing:.04em; text-transform:uppercase; margin-bottom: 18px; }
.footer-col li{ margin-bottom: 11px; font-size: .92rem; }
.footer-col a:hover{ color: var(--white); }
.footer-bottom{
  display:flex; flex-wrap:wrap; gap:16px;
  align-items:center; justify-content:space-between;
  padding-top: 26px;
  font-size: .82rem;
}
.footer-legal{ display:flex; gap:20px; flex-wrap:wrap; }
.footer-social{ display:flex; gap:12px; }
.footer-social a{ width:34px; height:34px; border:1px solid rgba(255,255,255,.2); display:flex; align-items:center; justify-content:center; }
.footer-social svg{ width:15px; height:15px; }

@media (max-width: 900px){
  .footer-grid{ grid-template-columns: 1fr 1fr; }
}
@media (max-width: 560px){
  .footer-grid{ grid-template-columns: 1fr; }
  .footer-bottom{ flex-direction:column; align-items:flex-start; }
}

/* =====================================================================
   Sticky mobile call bar
   ===================================================================== */
.mobile-call-bar{
  display:none;
  position: fixed;
  left:0; right:0; bottom:0;
  z-index: 150;
  background: var(--ink);
  padding: 12px 16px;
  gap: 10px;
}
@media (max-width: 700px){
  .mobile-call-bar{ display:flex; }
  body{ padding-bottom: 68px; }
}

/* ---------- Utility ---------- */
.center{ text-align:center; margin-left:auto; margin-right:auto; }
.mt-0{ margin-top:0 !important; }
